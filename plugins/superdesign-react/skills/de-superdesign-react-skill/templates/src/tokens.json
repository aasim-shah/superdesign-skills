{
 "_note": "The ONE token source. build.mjs turns it into the Tailwind theme (colors, fontFamily, borderRadius, boxShadow, maxWidth) and the type-role classes (.display-xl .h1 .h2 .h3 .h4 .lead .stat, body); contrast.py reads colors from it; the app build reuses it unchanged (tailwind.config or CSS custom properties). Replace the values with design-system.md sections 2 to 4 and keep the role names: components and tracks rely on them. Colors are primitives named by hue and step; roles stay in the spec. type sizes are [phone, desktop] px; the desktop size applies from breakpoint up.",
 "fonts": {
  "href": "https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&display=swap",
  "display": ["\"Inter Tight\"", "Inter", "system-ui", "sans-serif"],
  "sans": ["Inter", "system-ui", "sans-serif"]
 },
 "colors": {
  "ink": { "950": "#0E1626", "900": "#1B2538", "800": "#2B3549", "500": "#5A6378" },
  "line": "#E2E5EC",
  "paper": { "DEFAULT": "#F7F6F2", "2": "#EFEDE6" },
  "brand": { "50": "#EEF4FF", "100": "#DCE8FF", "500": "#3D7BEA", "600": "#1F5FD1", "700": "#184BA6" },
  "accent": { "400": "#FFC83D" },
  "success": "#1E7F55",
  "error": "#C42B3A",
  "white": "#FFFFFF"
 },
 "radius": { "card": "24px", "panel": "36px" },
 "shadow": {
  "sm": "0 1px 2px rgba(14,22,38,.08)",
  "md": "0 18px 40px -18px rgba(14,22,38,.28)",
  "lg": "0 40px 90px -40px rgba(14,22,38,.45)"
 },
 "maxWidth": { "site": "1280px" },
 "breakpoint": 768,
 "type": {
  "body": { "font": "sans", "size": [17, 18], "lh": 1.7, "color": "ink-800" },
  "display-xl": { "font": "display", "weight": 800, "size": [52, 104], "lh": 0.94, "track": "-0.045em", "color": "ink-950" },
  "h1": { "font": "display", "weight": 700, "size": [42, 72], "lh": 1, "track": "-0.04em", "color": "ink-950" },
  "h2": { "font": "display", "weight": 700, "size": [34, 52], "lh": 1.05, "track": "-0.035em", "color": "ink-950" },
  "h3": { "font": "display", "weight": 600, "size": [23, 28], "lh": 1.15, "track": "-0.02em", "color": "ink-950" },
  "h4": { "font": "display", "weight": 600, "size": [19, 21], "lh": 1.3, "track": "-0.01em", "color": "ink-950" },
  "lead": { "size": [19, 21], "lh": 1.55 },
  "stat": { "font": "display", "weight": 800, "size": [48, 72], "lh": 1, "track": "-0.04em", "color": "ink-950", "tabular": true }
 }
}
