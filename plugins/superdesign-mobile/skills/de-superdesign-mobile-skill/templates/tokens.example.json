{
 "_note": "Copy to .superdesign/src/tokens.json: the ONE token source. build.py turns it into the drafts' Tailwind config, light and dark custom properties and .t-<role> type classes (rem, so TEXT_SCALE renders grow like Dynamic Type); contrast.py checks it (--tokens, per theme); tokens_export.py writes the React Native theme/tokens.ts from it. Colors: primitives by hue and step. semantic: the names screens use (bg-surface, text-fg, text-fg-muted, bg-accent text-on-accent), per theme; values are primitives, name/NN opacities or #hex. type: points (size, lh), weight, track in points. radius and space in points. Change a value here only, then rebuild and re-run contrast.py and tokens_export.py.",
 "fonts": {
  "href": "https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap",
  "sans": ["Inter", "system-ui", "-apple-system", "sans-serif"],
  "display": ["Inter", "system-ui", "-apple-system", "sans-serif"]
 },
 "colors": {
  "ink": { "950": "#0B1220", "900": "#111827", "700": "#374151", "600": "#4B5563", "500": "#6B7280", "400": "#9CA3AF", "300": "#D1D5DB", "200": "#E5E7EB", "100": "#F1F2F4" },
  "paper": { "50": "#F7F7F5" },
  "night": { "950": "#07090D", "900": "#11151C", "800": "#1A1F28", "700": "#272E3A" },
  "brand": { "300": "#9DBBFF", "400": "#6E9CFF", "600": "#2457D6", "700": "#1B44AB" },
  "success": { "400": "#3CCB7F", "600": "#13804A" },
  "danger": { "400": "#FF7A70", "600": "#C7362F" },
  "white": "#FFFFFF",
  "black": "#000000"
 },
 "semantic": {
  "light": {
   "bg": "paper-50", "surface": "white", "surface-2": "ink-100", "fg": "ink-900", "fg-muted": "ink-600", "line": "ink-200",
   "accent": "brand-600", "on-accent": "white", "success": "success-600", "danger": "danger-600", "scrim": "ink-950/40"
  },
  "dark": {
   "bg": "night-950", "surface": "night-900", "surface-2": "night-800", "fg": "ink-100", "fg-muted": "ink-400", "line": "night-700",
   "accent": "brand-400", "on-accent": "night-950", "success": "success-400", "danger": "danger-400", "scrim": "black/60"
  }
 },
 "type": {
  "large-title": { "font": "display", "size": 34, "lh": 41, "weight": 700, "track": -0.6 },
  "title1": { "font": "display", "size": 28, "lh": 34, "weight": 700, "track": -0.4 },
  "title2": { "font": "display", "size": 22, "lh": 28, "weight": 700, "track": -0.3 },
  "title3": { "font": "display", "size": 20, "lh": 25, "weight": 600, "track": -0.2 },
  "headline": { "font": "sans", "size": 17, "lh": 22, "weight": 600, "track": -0.2 },
  "body": { "font": "sans", "size": 17, "lh": 22, "weight": 400, "track": -0.2 },
  "callout": { "font": "sans", "size": 16, "lh": 21, "weight": 400, "track": -0.15 },
  "subhead": { "font": "sans", "size": 15, "lh": 20, "weight": 400, "track": -0.1 },
  "footnote": { "font": "sans", "size": 13, "lh": 18, "weight": 400 },
  "caption": { "font": "sans", "size": 12, "lh": 16, "weight": 500 },
  "stat": { "font": "display", "size": 48, "lh": 52, "weight": 700, "track": -1.2, "tabular": true }
 },
 "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 20, "sheet": 28, "pill": 999 },
 "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48],
 "shadow": {
  "card": { "y": 1, "blur": 3, "color": "ink-950", "opacity": 0.06 },
  "raised": { "y": 8, "blur": 24, "color": "ink-950", "opacity": 0.12 },
  "sheet": { "y": -8, "blur": 32, "color": "ink-950", "opacity": 0.18 }
 }
}
